---
import type { CollectionEntry } from 'astro:content';
import { readingMinutes } from '../lib/reading';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const posts = [...Astro.props.posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))];
---

{years.map((year) => (
	<section class="year" aria-labelledby={`y${year}`}>
		<h2 id={`y${year}`}>{year}</h2>
		<ol class="posts">
			{posts.filter((p) => p.data.pubDate.getUTCFullYear() === year).map((p) => (
				<li>
					<time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(5, 10)}</time>
					<div class="entry">
						<h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
						<p class="desc">{p.data.description}</p>
						<p class="entry-meta">
							<span>約 {readingMinutes(p.body)} 分鐘</span>
							{p.data.tags.map((t) => <span>#{t}</span>)}
							{p.data.draft && <span class="draft-flag">草稿</span>}
						</p>
					</div>
				</li>
			))}
		</ol>
	</section>
))}
