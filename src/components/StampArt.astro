---
// 郵票上的版畫圖樣：純幾何線條，依專案內容決定畫什麼。
// kit：九個工具各一枚小圖示（證件、條碼、公司、銀行、郵件、日曆、年份互轉、金額、骰子）。
interface Props {
	kind: 'kit';
}
const { kind } = Astro.props;
const icons = [
	// 身分證
	'<rect x="3" y="6" width="18" height="12" rx="1.5"/><circle cx="8.5" cy="11" r="1.8"/><path d="M5.5 15.5c.6-1.6 1.6-2.2 3-2.2s2.4.6 3 2.2M13.5 10h5M13.5 13.5h5"/>',
	// 手機條碼
	'<path d="M4 5v14M7 5v14M10 5v14M13 5v14M16 5v14M20 5v14" stroke-width="1.2"/><path d="M4 5h16M4 19h16" stroke-width="0.8"/>',
	// 統一編號（公司）
	'<rect x="6" y="3.5" width="12" height="17" rx="1"/><path d="M9.5 7.5h1.5M13 7.5h1.5M9.5 11h1.5M13 11h1.5M9.5 14.5h1.5M13 14.5h1.5M10.5 20.5v-3h3v3"/>',
	// 銀行
	'<path d="M3 9.5 12 4l9 5.5zM6 12v6M10 12v6M14 12v6M18 12v6M3.5 20.5h17"/>',
	// 郵遞區號
	'<rect x="3" y="6" width="18" height="12" rx="1"/><path d="m3.5 7 8.5 6.5L20.5 7"/>',
	// 假日
	'<rect x="4" y="5" width="16" height="15" rx="1.5"/><path d="M4 10h16M8 3v4M16 3v4M8 14h2M14 14h2M8 17h2"/>',
	// 民國年轉換
	'<path d="M4 9h15m-3.5-3.5L19 9l-3.5 3.5M20 15H5m3.5-3.5L5 15l3.5 3.5"/>',
	// 中文大寫金額（錢幣）
	'<circle cx="12" cy="12" r="8.5"/><rect x="9.5" y="9.5" width="5" height="5"/>',
	// 假資料（骰子）
	'<rect x="4" y="4" width="16" height="16" rx="2.5"/><circle cx="9" cy="9" r=".6"/><circle cx="15" cy="9" r=".6"/><circle cx="12" cy="12" r=".6"/><circle cx="9" cy="15" r=".6"/><circle cx="15" cy="15" r=".6"/>',
];
---

{kind === 'kit' && (
	<svg class="stamp-art" viewBox="0 0 84 84" preserveAspectRatio="xMinYMin meet" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
		{icons.map((d, i) => (
			<g transform={`translate(${(i % 3) * 30} ${Math.floor(i / 3) * 30})`} set:html={d} />
		))}
	</svg>
)}
