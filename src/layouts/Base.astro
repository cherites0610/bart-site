---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
	title?: string;
	description?: string;
}
const { title, description = '廖柏安 Bart：全端開發者，從人的需求出發，把事情做成系統。' } = Astro.props;
const fullTitle = title ? `${title}｜廖柏安 Bart` : '廖柏安 Bart';
const nav = [
	['/', '首頁'],
	['/blog', 'Blog'],
	['/projects', 'Portfolio'],
	['/about', 'About'],
	['/links', 'Links'],
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="廖柏安 Bart" href="/rss.xml" />
		<title>{fullTitle}</title>
		<script is:inline>
			const t = localStorage.getItem('theme');
			if (t) document.documentElement.dataset.theme = t;
		</script>
	</head>
	<body>
		<header>
			<nav aria-label="主選單">
				{nav.map(([href, label]) => (
					<a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
				))}
				<ThemeToggle />
			</nav>
		</header>
		<main><slot /></main>
		<footer><small>© 廖柏安 Bart</small></footer>
	</body>
</html>
