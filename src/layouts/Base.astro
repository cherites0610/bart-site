---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
	title?: string;
	description?: string;
}
const { title, description = '廖柏安 Bart：全端開發者，從人的需求出發，把事情做成系統。' } = Astro.props;
const fullTitle = title ? `${title}｜廖柏安 Bart` : '廖柏安 Bart';
const nav = [
	['/', '首頁'],
	['/blog', 'Blog'],
	['/projects', 'Portfolio'],
	['/about', 'About'],
];
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonical} />
		<meta name="theme-color" content="#14213a" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="zh_TW" />
		<meta property="og:site_name" content="廖柏安 Bart" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="alternate" type="application/rss+xml" title="廖柏安 Bart" href="/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500&family=Noto+Serif+TC:wght@700&display=swap"
		/>
		<title>{fullTitle}</title>
		<script is:inline>
			const t = localStorage.getItem('theme');
			if (t) document.documentElement.dataset.theme = t;
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">跳到主要內容</a>
		<header class="site-header">
			<nav aria-label="主選單">
				{nav.map(([href, label]) => (
					<a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
				))}
				<ThemeToggle />
			</nav>
		</header>
		<main id="main"><slot /></main>
		<footer class="site-footer"><small>© 廖柏安 Bart</small></footer>
	</body>
</html>
