---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readingMinutes } from '../../lib/reading';

export async function getStaticPaths() {
	// 草稿只在 dev 預覽，正式建置不輸出
	const posts = await getCollection('blog', (p) => import.meta.env.DEV || !p.data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);

const { title, description, pubDate, tags, draft } = post.data;
const iso = pubDate.toISOString().slice(0, 10);
const minutes = readingMinutes(post.body);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={title} description={description}>
	<div class="reading">
		<article class="post">
			<header class="post-head">
				<p class="post-meta">
					<time datetime={iso}>{iso}</time>
					<span>約 {minutes} 分鐘讀完</span>
					{draft && <span class="draft-flag">草稿・僅 dev 可見</span>}
				</p>
				<h1>{title}</h1>
				<p class="post-lede">{description}</p>
			</header>

			{toc.length > 1 && (
				<nav class="toc toc-inline" aria-label="文章目錄">
					<details>
						<summary>目錄</summary>
						<ol>
							{toc.map((h) => (
								<li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
							))}
						</ol>
					</details>
				</nav>
			)}

			<div class="prose"><Content /></div>

			<footer class="post-foot">
				{tags.length > 0 && (
					<ul class="tags" aria-label="標籤">
						{tags.map((t) => <li><a href={`/blog/tags/${t}`}>#{t}</a></li>)}
					</ul>
				)}
				<a class="back" href="/blog">回到文章列表</a>
			</footer>
		</article>

		{toc.length > 1 && (
			<nav class="toc toc-side" aria-label="文章目錄">
				<p class="toc-title">目錄</p>
				<ol>
					{toc.map((h) => (
						<li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
					))}
				</ol>
			</nav>
		)}
	</div>
	<div class="progress" aria-hidden="true"></div>
</Base>

<script>
	// 閱讀進度與目前章節；沒有 JS 時頁面完全可讀
	const bar = document.querySelector<HTMLElement>('.progress');
	const article = document.querySelector<HTMLElement>('.post');
	if (bar && article) {
		const update = () => {
			const r = article.getBoundingClientRect();
			const total = r.height - window.innerHeight;
			const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
			bar.style.transform = `scaleX(${p})`;
		};
		update();
		addEventListener('scroll', update, { passive: true });
		addEventListener('resize', update);
	}
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-side a')];
	if (links.length) {
		const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					links.forEach((a) => a.removeAttribute('aria-current'));
					map.get(e.target.id)?.setAttribute('aria-current', 'true');
				}
			},
			{ rootMargin: '0px 0px -75% 0px' },
		);
		map.forEach((_, id) => {
			const el = document.getElementById(id);
			if (el) io.observe(el);
		});
	}
</script>
