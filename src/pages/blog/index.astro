---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title="Blog">
	<h1>Blog</h1>
	{posts.length === 0 ? (
		<p class="placeholder">【預留位置】尚無文章。</p>
	) : (
		<ul>
			{posts.map((p) => (
				<li>
					<time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
					<a href={`/blog/${p.id}`}>{p.data.title}</a>
				</li>
			))}
		</ul>
	)}
</Base>
